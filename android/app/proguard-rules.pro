# Generated by tool/platform_patches/apply.py. Extra R8 rules; the Flutter Gradle plugin and the
# plugins' consumer rules already cover the rest.

# flutter_local_notifications serialises scheduled notifications with Gson + reflection:
# generic type signatures and the model classes must survive shrinking/obfuscation.
-keepattributes Signature,InnerClasses,EnclosingMethod,*Annotation*
-keep class com.dexterous.flutterlocalnotifications.** { *; }
-keep class com.google.gson.reflect.TypeToken { *; }
-keep class * extends com.google.gson.reflect.TypeToken
-keep class com.google.gson.stream.** { *; }
-keepclassmembers,allowobfuscation class * {
    @com.google.gson.annotations.SerializedName <fields>;
}

# drift / sqlite3 reach SQLite through Dart FFI (no Java reflection); keep JNI entry points anyway.
-keepclasseswithmembernames class * {
    native <methods>;
}

# Optional Play Core split-install classes referenced by the Flutter engine (not used here).
-dontwarn com.google.android.play.core.**
-dontwarn com.google.errorprone.annotations.**
-dontwarn javax.annotation.**
